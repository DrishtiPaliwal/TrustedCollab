{
  "name": "Review",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "reviewer_user_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_type": {
      "type": "string",
      "enum": [
        "creator",
        "brand"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "subject_user_id": {
      "type": "string"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "creator",
        "brand"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "rating": {
      "type": "number"
    },
    "comment": {
      "type": "string"
    },
    "verified_collaboration": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "reviewer_user_id",
    "subject_user_id",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.reviewer_user_id": "{{user.id}}"
        },
        {
          "data.subject_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}