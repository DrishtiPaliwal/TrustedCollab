{
  "name": "CreatorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "niches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "years_experience": {
      "type": "number"
    },
    "collaboration_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_industries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_fee_min": {
      "type": "number"
    },
    "expected_fee_max": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "INR"
    },
    "audience_geography": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience_age_range": {
      "type": "string"
    },
    "audience_gender_split": {
      "type": "string"
    },
    "audience_interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_followers": {
      "type": "number",
      "default": 0
    },
    "average_engagement_rate": {
      "type": "number",
      "default": 0
    },
    "availability": {
      "type": "string",
      "enum": [
        "open",
        "limited",
        "closed"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "default": "open"
    },
    "website": {
      "type": "string"
    },
    "profile_completion": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}