{
  "name": "SocialAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "youtube",
        "instagram",
        "linkedin",
        "facebook",
        "x",
        "tiktok",
        "other"
      ],
      "enumColors": [
        "red",
        "pink",
        "blue",
        "blue",
        "gray",
        "purple",
        "gray"
      ]
    },
    "handle": {
      "type": "string"
    },
    "external_account_id": {
      "type": "string"
    },
    "account_url": {
      "type": "string"
    },
    "followers": {
      "type": "number",
      "default": 0
    },
    "reach": {
      "type": "number",
      "default": 0
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "engagement_rate": {
      "type": "number",
      "default": 0
    },
    "average_views": {
      "type": "number",
      "default": 0
    },
    "content_count": {
      "type": "number",
      "default": 0
    },
    "audience_geography": {
      "type": "string"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "pending",
        "verified",
        "rejected",
        "requires_renewal"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red",
        "yellow"
      ],
      "default": "not_submitted"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "oauth_connected",
        "self_reported"
      ],
      "enumColors": [
        "green",
        "yellow"
      ],
      "default": "self_reported"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "platform"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}